---
/**
 * Shared page shell. Every tool and site page uses this.
 * Props: title, description, tool (optional: shows a small back link), wide (optional).
 */
import '@present/shared/global.css';
const { title, description = '', tool = false, theme = '' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const fullTitle = title === 'present' ? 'present' : `${title} · present`;
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf8f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1613" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
    <title>{fullTitle}</title>
  </head>
  <body class={`bg-bg text-text antialiased ${theme}`}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:btn">Skip to content</a>
    {tool && (
      <header class="mx-auto w-full max-w-3xl px-5 pt-5 flex items-center justify-between print:hidden">
        <a href={base} class="text-muted hover:text-text text-[15px] inline-flex items-center gap-2 min-h-11">
          <span aria-hidden="true">←</span> present
        </a>
        <span class="text-muted text-[15px]">{title}</span>
      </header>
    )}
    <main id="main" class="mx-auto w-full max-w-3xl px-5 pb-16 pt-6 sm:pt-10">
      <slot />
    </main>
    <script>
      if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
        const base = document.documentElement.dataset.base || '/';
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(base + 'sw.js', { scope: base }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
