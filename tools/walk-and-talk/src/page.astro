---
import Layout from '@present/shared/Layout.astro';
---
<Layout title="Walk & Talk" description="One prompt, then the screen goes dark until the walk is over." tool>
  <div id="app" class="min-h-[70dvh] flex flex-col">

    <section data-view="setup" class="flex-1 flex flex-col gap-8">
      <div>
        <p class="eyebrow mb-3">Walk &amp; Talk</p>
        <h1 class="display text-4xl sm:text-5xl">One question. Then pockets.</h1>
        <p class="mt-4 text-muted text-lg max-w-md">Read the prompt together, put the phone away, and walk. It will buzz once at halfway.</p>
      </div>
      <form id="setup" class="flex flex-col gap-6" autocomplete="off">
        <label class="block">
          <span class="eyebrow block mb-2">Walking with</span>
          <input class="field text-lg" type="text" name="partner" maxlength="30" placeholder="A name" enterkeyhint="done" />
        </label>
        <fieldset>
          <legend class="eyebrow mb-2">How long</legend>
          <div class="grid grid-cols-4 gap-2" id="durations">
            <button type="button" class="btn" data-min="15">15</button>
            <button type="button" class="btn btn-primary" data-min="30">30</button>
            <button type="button" class="btn" data-min="45">45</button>
            <button type="button" class="btn" data-min="60">60</button>
          </div>
          <p class="text-muted text-sm mt-2">minutes</p>
        </fieldset>
        <button type="submit" class="btn btn-primary text-lg py-4">Get our prompt</button>
      </form>
      <details id="past" class="text-muted" hidden>
        <summary class="cursor-pointer min-h-11 inline-flex items-center">Past walks</summary>
        <ul id="past-list" class="mt-3 flex flex-col gap-2 text-[15px]"></ul>
      </details>
    </section>

    <section data-view="prompt" class="flex-1 flex flex-col" hidden>
      <p class="eyebrow">For the walk with <span data-bind="partner"></span></p>
      <div class="flex-1 flex flex-col justify-center py-10">
        <p class="display text-4xl sm:text-5xl leading-[1.15]" data-bind="prompt"></p>
      </div>
      <button type="button" class="btn btn-primary text-lg py-4" data-action="begin">Phone away. Start walking.</button>
    </section>

    <section data-view="walking" class="flex-1 flex flex-col items-center justify-center gap-10" hidden>
      <p class="text-[15px] opacity-40" data-bind="walking-line"></p>
      <button type="button" class="rounded-full h-40 w-40 border border-white/20 text-white/70 text-lg" data-action="end">End walk</button>
    </section>

    <section data-view="done" class="flex-1 flex flex-col gap-8" hidden>
      <div>
        <p class="eyebrow mb-3">Walk over</p>
        <h1 class="display text-4xl" data-bind="done-title"></h1>
        <p class="mt-4 text-muted text-lg" data-bind="done-prompt"></p>
      </div>
      <form id="note" class="flex flex-col gap-3" autocomplete="off">
        <label class="block">
          <span class="eyebrow block mb-2">One line to remember it by</span>
          <input class="field text-lg" type="text" name="note" maxlength="140" placeholder="Optional" enterkeyhint="done" />
        </label>
        <div class="flex gap-3 flex-wrap">
          <button type="submit" class="btn btn-primary">Save and finish</button>
          <a href="./" class="btn">Finish without a note</a>
        </div>
      </form>
    </section>

  </div>
  <style is:global>
    body.walking { background: #050403; color: #f1dfc4; }
    body.walking header { display: none; }
  </style>
  <script src="./walk.js"></script>
</Layout>
