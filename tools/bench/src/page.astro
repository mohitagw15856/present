---
import Layout from '@present/shared/Layout.astro';
---
<Layout title="Bench" description="Sit somewhere. The screen goes dark. At the end: what did you see?" tool>
  <div id="app" class="min-h-[70dvh] flex flex-col">
    <section data-view="setup" class="flex-1 flex flex-col gap-8">
      <div>
        <p class="eyebrow mb-3">Bench</p>
        <h1 class="display text-4xl sm:text-5xl">Sit. Look. That is all.</h1>
        <p class="mt-4 text-muted text-lg max-w-md">Pick how long, put the phone face down beside you, and watch the street. It will ask you one thing at the end.</p>
      </div>
      <fieldset>
        <legend class="eyebrow mb-2">How long</legend>
        <div class="grid grid-cols-4 gap-2" id="durations">
          <button type="button" class="btn" data-min="5">5</button>
          <button type="button" class="btn btn-primary" data-min="10">10</button>
          <button type="button" class="btn" data-min="15">15</button>
          <button type="button" class="btn" data-min="20">20</button>
        </div>
        <p class="text-muted text-sm mt-2">minutes</p>
      </fieldset>
      <button type="button" class="btn btn-primary text-lg py-4" data-action="begin">Phone down. Begin.</button>
      <details id="past" class="text-muted" hidden>
        <summary class="cursor-pointer min-h-11 inline-flex items-center">What you saw before</summary>
        <ul id="past-list" class="mt-3 flex flex-col gap-2 text-[15px]"></ul>
      </details>
    </section>
    <section data-view="sitting" class="flex-1 flex flex-col items-center justify-center gap-10" hidden>
      <p class="text-[15px] opacity-40">Sitting</p>
      <button type="button" class="rounded-full h-40 w-40 border border-white/20 text-white/70 text-lg" data-action="end">Get up</button>
    </section>
    <section data-view="done" class="flex-1 flex flex-col gap-8" hidden>
      <div>
        <p class="eyebrow mb-3">Bench</p>
        <h1 class="display text-4xl">What did you see?</h1>
        <p class="mt-4 text-muted text-lg" data-bind="mins"></p>
      </div>
      <form id="note" class="flex flex-col gap-3" autocomplete="off">
        <input class="field text-lg" type="text" name="note" maxlength="140" placeholder="One line. Optional." enterkeyhint="done" />
        <div class="flex gap-3 flex-wrap">
          <button type="submit" class="btn btn-primary">Keep it</button>
          <a href="./" class="btn">Nothing to add</a>
        </div>
      </form>
    </section>
  </div>
  <style is:global>
    body.sitting { background: #050403; color: #f1dfc4; }
    body.sitting header { display: none; }
  </style>
  <script src="./bench.js"></script>
</Layout>
