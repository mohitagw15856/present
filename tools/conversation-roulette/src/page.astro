---
import Layout from '@present/shared/Layout.astro';
---
<Layout title="Conversation Roulette" description="Pick a depth, tap for a question, answer out loud. Tracks nothing." tool>
  <div id="app" class="min-h-[70dvh] flex flex-col">

    <section data-view="pick" class="flex-1 flex flex-col gap-8">
      <div>
        <p class="eyebrow mb-3">Conversation Roulette</p>
        <h1 class="display text-4xl sm:text-5xl">How deep shall we go?</h1>
        <p class="mt-4 text-muted text-lg max-w-md">One phone, in the middle. Tap for a question, answer it out loud, pass it on.</p>
      </div>
      <div class="grid gap-3">
        <button type="button" class="btn justify-between text-left py-5 px-6" data-depth="light">
          <span class="text-lg">Light</span><span class="text-muted text-[15px]">anyone, anywhere</span>
        </button>
        <button type="button" class="btn justify-between text-left py-5 px-6" data-depth="real">
          <span class="text-lg">Real</span><span class="text-muted text-[15px]">a little honesty</span>
        </button>
        <button type="button" class="btn justify-between text-left py-5 px-6" data-depth="deep">
          <span class="text-lg">Deep</span><span class="text-muted text-[15px]">trust and time</span>
        </button>
        <button type="button" class="btn justify-between text-left py-5 px-6" data-depth="any">
          <span class="text-lg">Mix</span><span class="text-muted text-[15px]">a little of each</span>
        </button>
      </div>
    </section>

    <section data-view="play" class="flex-1 flex flex-col" hidden>
      <div class="flex items-center justify-between">
        <p class="eyebrow">Roulette · <span data-bind="depth-label"></span></p>
        <button type="button" class="btn btn-quiet min-h-11 px-3" data-action="change">Change depth</button>
      </div>
      <button type="button" data-action="next" class="flex-1 flex flex-col justify-center text-left py-10 sm:py-16 -mx-2 px-2 rounded-xl active:bg-surface-2 transition-colors" aria-label="Next question">
        <span class="display text-4xl sm:text-6xl leading-[1.15] block" data-bind="question" aria-live="polite">Tap anywhere for the first question.</span>
        <span class="mt-8 self-start inline-flex items-center rounded-full px-3 py-1 text-sm font-medium capitalize" data-bind="pill" hidden></span>
      </button>
      <p class="text-muted text-[15px] text-center pb-2">Tap the question for the next one. Nothing is saved.</p>
    </section>

  </div>
  <script src="./roulette.js"></script>
</Layout>
