---
import Layout from '@present/shared/Layout.astro';
import { colours } from '@present/shared/pdf';
---
<Layout title="Guest Book" description="A printable page for the fridge: who came round this month." tool>
  <div class="flex flex-col gap-8">
    <div>
      <p class="eyebrow mb-3">Guest Book</p>
      <h1 class="display text-4xl sm:text-5xl">Who came round.</h1>
      <p class="mt-4 text-muted text-lg max-w-md">One printed page a month for the fridge or the front door. A dated line per visit, in pen. The analogue Presence Ledger.</p>
    </div>
    <form id="f" class="flex flex-col gap-6" autocomplete="off">
      <div class="grid grid-cols-2 gap-3 max-w-sm">
        <label class="block"><span class="eyebrow block mb-2">Month</span><input class="field" type="month" name="month" required /></label>
        <label class="block"><span class="eyebrow block mb-2">Household</span><input class="field" type="text" name="house" maxlength="30" placeholder="Optional" /></label>
      </div>
      <fieldset>
  <legend class="eyebrow mb-2">Colour</legend>
  <div class="flex gap-3" id="colours">
    {Object.entries(colours).map(([id, c]) => (
      <button type="button" class="h-12 w-12 rounded-full" data-colour={id} style={`background:${c.fill}`} aria-label={c.name} title={c.name} aria-pressed={id === 'sage' ? 'true' : 'false'}></button>
    ))}
  </div>
</fieldset>
<style>#colours [aria-pressed="true"] { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--text); }</style>
      <button type="button" class="btn btn-primary text-lg py-4 self-start" data-action="pdf">Download the page (PDF)</button>
    </form>
  </div>
  <script src="./guest-book.js"></script>
</Layout>
